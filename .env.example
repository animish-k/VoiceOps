# ==============================================================================
# VoiceOps Environment Variables Example
# Duplicate this file as .env and fill in valid credentials.
# NOTE: Never commit .env or real credentials to source control.
# ==============================================================================

# LiveKit Realtime Server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI / LLM Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key

# Voice / Spoken Output Provider (Rime TTS)
RIME_API_KEY=your_rime_api_key

# HTTP / Server Configuration
PORT=4000
VITE_API_URL=http://localhost:4000
