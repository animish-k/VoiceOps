{
  "name": "voiceops-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=@voiceops/web run dev",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm --workspace=@voiceops/shared run test"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^5.4.5"
  }
}
